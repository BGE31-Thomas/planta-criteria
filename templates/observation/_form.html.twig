{{ form_start(observationForm) }}

{{ form_row(observationForm.date_heure) }}
{{ form_row(observationForm.lieu) }}
<datalist id="communes-list"></datalist>
<table>
    <tr>
        <th>Organe</th>
        <th>Description</th>
        <th>Statut</th>
    </tr>

    {% for oc in observationForm.observationsCritere %}
        <tr>
            <td>{{ oc.vars.data.critere.organe }}</td>
            <td>{{ oc.vars.data.critere.description }}</td>
            <td>{{ form_widget(oc.statut) }}</td>
        </tr>
    {% endfor %}
</table>

<button class="btn btn-danger mt-4">Enregistrer</button>

{{ form_end(observationForm, { render_rest: false }) }}

<script>
    document.addEventListener('DOMContentLoaded', function () {
        flatpickr(".js-datepicker", {
            dateFormat: "d-m-Y",
            locale: "fr",
            maxDate: "today"
        });

        const input = document.querySelector('#{{ observationForm.lieu.vars.id }}');
        const datalist = document.getElementById('communes-list');

        let timeout = null;

        input.addEventListener('input', function () {
            clearTimeout(timeout);

            const query = this.value;

            if (query.length < 2) return;

            timeout = setTimeout(() => {
                fetch('/api/communes?q=' + encodeURIComponent(query))
                    .then(response => response.json())
                    .then(data => {
                        datalist.innerHTML = '';

                        data.forEach(item => {
                            const option = document.createElement('option');
                            option.value = item.text;
                            datalist.appendChild(option);
                        });
                    });
            }, 200);
        });
    });
</script>