{{ form_start(observationForm) }}

{{ form_row(observationForm.date_heure) }}
{{ form_row(observationForm.lieu) }}
<datalist id="communes-list"></datalist>
<table>
    <tr>
        <th>Organe</th>
        <th>Description</th>
        <th>Statut</th>
    </tr>

    {% for oc in observationForm.observationsCritere %}
        <tr>
            <td>{{ oc.vars.data.critere.organe }}</td>
            <td>{{ oc.vars.data.critere.description }}</td>
            <td>{{ form_widget(oc.statut) }}</td>
            <td>
                {{ form_widget(oc.images, {
                    attr: {
                        class: 'image-input'
                    }
                }) }}
            </td>
        </tr>
        <tr>
            <div class="preview-container"></div>
        </tr>
    {% endfor %}
</table>

<button class="btn btn-danger mt-4">Enregistrer</button>

{{ form_end(observationForm, { render_rest: false }) }}

<script>
    document.addEventListener('DOMContentLoaded', function () {
        flatpickr(".js-datepicker", {
            dateFormat: "d-m-Y",
            altInput: true,
            altFormat: "d-m-Y",
            dateFormat: "Y-m-d", // IMPORTANT
            locale: "fr",
            maxDate: "today"
        });

        const input = document.querySelector('#{{ observationForm.lieu.vars.id }}');
        const datalist = document.getElementById('communes-list');

        let timeout = null;

        input.addEventListener('input', function () {
            clearTimeout(timeout);

            const query = this.value;

            if (query.length < 2) return;

            timeout = setTimeout(() => {
                fetch('/api/communes?q=' + encodeURIComponent(query))
                    .then(response => response.json())
                    .then(data => {
                        datalist.innerHTML = '';

                        data.forEach(item => {
                            const option = document.createElement('option');
                            option.value = item.text;
                            datalist.appendChild(option);
                        });
                    });
            }, 200);
        });

        document.querySelectorAll('.image-input').forEach(input => {

            input.addEventListener('change', function (event) {

                const container = this.closest('td').querySelector('.preview-container');
                container.innerHTML = '';

                Array.from(event.target.files).forEach(file => {

                    const reader = new FileReader();

                    reader.onload = function (e) {
                        const img = document.createElement('img');
                        img.src = e.target.result;
                        img.style.width = '100px';
                        img.style.marginRight = '5px';
                        container.appendChild(img);
                    };

                    reader.readAsDataURL(file);
                });
            });
        });
    });
</script>