{{form_start(critereForm)}}
    {{ form_row(critereForm.source) }}
   
    <a href="{{ path('app_admin_source_add', { redirect: app.request.uri }) }}" target="_blank">
        Ajouter une source
    </a>

    {{ form_row(critereForm.organe) }}
    {{ form_row(critereForm.description) }}
    
    
    {% if app.request.attributes.get('_route') == 'app_admin_critere_edit' %}
        <h2>Images</h2>
        {% for image in critere.images %}
            <div>
                <img src="{{asset('assets/uploads/criteres/mini/300x300-' ~ image.chemin)}}" alt="{{image.description}}" width="300"/>
                <a href="{{path('app_admin_critere_delete_image',{id:image.id})}}" data-delete data-token="{{csrf_token('delete' ~ image.id)}}">Supprimer</a>
            </div>
        {% endfor %}
    {% endif %}
    {{ form_row(critereForm.images) }}
    
    <button type="submit" class="btn btn-primary">{{button_label |default('Ajouter')}}</button>
{{ form_end(critereForm) }}