{% extends 'base.html.twig' %}

{% block body %}
<h1>{{ plant.nomCompletHtml|raw }}</h1>

<h3>Synonymes</h3>
<ul>
    {% for syn in synonymes %}
        {% if syn.cdNom != plant.cdNom %}
            <li>{{ syn.nomCompletHtml|raw }}</li>
        {% endif %}
    {% endfor %}
</ul>

<h3>Critères</h3>


    {% set currentSource = '' %}

    {% for crt in criteres %}
        {% set sourceTitre = crt.source ? crt.source.titre : 'Source inconnue' %}

        {% if sourceTitre != currentSource %}
            {% if currentSource != '' %}
                </ul>
            {% endif %}

            <h4 class="mt-4">{{ sourceTitre }}</h4>
            <ul>
            {% set currentSource = sourceTitre %}
        {% endif %}

                <li>
                    {{ crt.organe }} {{ crt.description }}
                    <a href="{{ path('app_admin_critere_edit', { id: crt.id, idPlante: plant.cdNom }) }}">Modifier</a>

                    {% for image in crt.images %}
                        <div class="mt-2">
                            <img src="{{ asset('assets/uploads/criteres/mini/300x300-' ~ image.chemin) }}"
                                alt="{{ image.description }}" width="150"/>
                        </div>
                    {% endfor %}
                </li>
    {% endfor %}
            </ul>


<a href="{{path('app_admin_critere_add',{ id: plant.cdNom })}}">Ajouter un critère</a>
{% endblock %}