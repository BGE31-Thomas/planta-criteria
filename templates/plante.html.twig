{% extends 'base.html.twig' %}

{% block body %}
<h1>{{ plant.nomCompletHtml|raw }}</h1>

<h3>Famille</h3>
<p>{{ plant.famille }}</p>

<h3>Synonymes</h3>
<ul>
    {% for syn in synonymes %}
        {% if syn.cdNom != plant.cdNom %}
            <li>{{ syn.nomCompletHtml|raw }}</li>
        {% endif %}
    {% endfor %}
</ul>

<h3>Critères</h3>


    {% set currentSource = '' %}

    {% for crt in criteres %}
        {% set sourceTitre = crt.source ? crt.source.titre : 'Source inconnue' %}

        {% if sourceTitre != currentSource %}
            {% if currentSource != '' %}
                </ul>
            {% endif %}

            <h4 class="mt-4">{{ sourceTitre }}</h4>
            <ul>
            {% set currentSource = sourceTitre %}
        {% endif %}

                <li>
                    {{ crt.organe }} {{ crt.description }}
                    <a href="{{ path('app_admin_critere_edit', { id: crt.id, idPlante: plant.cdNom }) }}">Modifier</a>

                    {% for image in crt.images %}
                        <div class="mt-2">
                            <img src="{{ absolute_url(asset('assets/uploads/criteres/' ~ image.chemin)) }}"
                                alt="{{ image.description }}" width="50%"/>
                        </div>
                    {% endfor %}
                </li>
    {% endfor %}
            </ul>


<a href="{{path('app_admin_critere_add',{ id: plant.cdNom })}}">Ajouter un critère</a>

<div>
    <a href="{{ path('app_export_pdf', { id: plant.cdNom }) }}" target="_blank">
        <button class="btn btn-primary mt-4">Exporter en PDF</button>
    </a>
</div>

<div>
    <a href="{{ path('app_observation_add', { idPlante: plant.cdNom }) }}" target="_blank">
        <button class="btn btn-primary mt-4">Ajouter une observation</button>
    </a>
</div>
{% endblock %}